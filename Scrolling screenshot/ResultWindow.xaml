<Window x:Class="Recture.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图成果" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10" >
            <Button x:Name="FitButton" Content="适应窗口" Width="90" Margin="5" />
            <Button x:Name="ActualSizeButton" Content="实际大小" Width="90" Margin="5" />
            <Button x:Name="ZoomOutButton" Content="-" Width="30" Margin="5" />
            <Slider x:Name="ZoomSlider" Width="120" Minimum="0.1" Maximum="3.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="False" Margin="5" />
            <Button x:Name="ZoomInButton" Content="+" Width="30" Margin="5" />
            <Button x:Name="CopyButton" Content="复制到剪贴板" Width="120" Margin="5" />
            <Button x:Name="SaveButton" Content="另存为文件" Width="120" Margin="5" />
            <Button x:Name="CloseButton" Content="关闭" Width="80" Margin="5" />
        </StackPanel>

        <ScrollViewer x:Name="ImageScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="10" PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel" CanContentScroll="False">
            <StackPanel x:Name="ImagePanel" Orientation="Vertical" />
        </ScrollViewer>
    </Grid>
</Window>