<Window x:Class="Recture.ManualPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预览" Height="300" Width="300" WindowStyle="ToolWindow" ResizeMode="NoResize" Topmost="True">
    <Grid>
        <StackPanel>
            <TextBlock x:Name="StatusText" Margin="4" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="PreviewImage" Stretch="None" />
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>