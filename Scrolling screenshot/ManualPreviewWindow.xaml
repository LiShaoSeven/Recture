<Window x:Class="Recture.ManualPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图进度预览" Height="520" Width="420"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Topmost="True"
        MinWidth="260" MinHeight="260">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusText" Margin="8 6 8 4" FontWeight="SemiBold" />
        <Border Grid.Row="1" Background="#FFEEEEEE" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="2" Margin="8 0 8 8"
                x:Name="ImageHost">
            <Viewbox Stretch="Uniform" x:Name="ImageViewbox">
                <Image x:Name="PreviewImage" Stretch="None" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
            </Viewbox>
        </Border>
    </Grid>
</Window>
